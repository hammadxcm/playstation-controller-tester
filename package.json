{
  "name": "playstation-controller-tester",
  "version": "1.3.0",
  "description": "Test PS5 DualSense, PS4 DualShock 4, Xbox and any gamepad in the browser: drift, circularity, rumble, adaptive triggers, lightbar, touchpad, gyro, audio.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Hammad Khan <hammadkhanxcm@gmail.com>",
  "homepage": "https://dualsense.fyniti.co.uk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hammadxcm/playstation-controller-tester.git"
  },
  "bugs": {
    "url": "https://github.com/hammadxcm/playstation-controller-tester/issues"
  },
  "keywords": [
    "gamepad",
    "dualsense",
    "dualshock",
    "xbox",
    "webhid",
    "controller-tester",
    "stick-drift",
    "adaptive-triggers"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "html-to-image": "^1.11.13",
    "motion": "13.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
